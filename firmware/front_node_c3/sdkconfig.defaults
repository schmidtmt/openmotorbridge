# Target Configuration for ESP32-C3FH4 RISC-V SoC (PCBA 05 U10)
CONFIG_IDF_TARGET="esp32c3"
CONFIG_IDF_TARGET_ESP32C3=y

# CPU & Clocks (160 MHz RISC-V, 40.000 MHz XTAL)
CONFIG_ESP32C3_DEFAULT_CPU_FREQ_160=y
CONFIG_ESP32C3_DEFAULT_CPU_FREQ_MHZ=160
CONFIG_XTAL_FREQ_40=y
CONFIG_FREERTOS_HZ=1000

# Flash Configuration (4MB Embedded SIP Flash)
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# Power Management & Dynamic Frequency Scaling
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=y

# USB Serial / JTAG Console (Disabled for runtime, Full Speed USB Device active on GPIO18/19)
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_NUM=0
CONFIG_ESP_CONSOLE_UART_TX_NUM=21
CONFIG_ESP_CONSOLE_UART_RX_NUM=20

# Disable Wi-Fi & Bluetooth to guarantee 100% Zero 2.4 GHz RF Emission on PCBA 05 Cockpit
CONFIG_BT_ENABLED=n
CONFIG_WIFI_ENABLED=n

# Compiler Optimization for Low Latency
CONFIG_COMPILER_OPTIMIZATION_PERF=y

