# ==============================================================================
# OpenMotorBridge ESP32-S31 Target & Architecture Configuration
# Hardware MCU: Espressif ESP32-S31 (54-GPIO QFN-68, Dual-Core RISC-V @ 320MHz)
# Native compilation for ESP32-S31 RISC-V architecture via ESP-IDF v6.1+
# ==============================================================================
CONFIG_IDF_TARGET="esp32s31"
CONFIG_IDF_TARGET_ESP32S31=y

# CPU & Memory Options (320 MHz Dual-Core RISC-V with SIMD)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_320=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=320

# FreeRTOS & Dual-Core Config
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_NUMBER_OF_CORES=2
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# PSRAM Support (8 MB Octal)
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y

# Bluetooth NimBLE Stack
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=3
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=y

# Flash & Dual-OTA Partition Table (8 MB / 16 MB Flash)
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# LittleFS / FATFS Support
CONFIG_FATFS_SECTOR_512=y
CONFIG_FATFS_LFN_HEAP=y
