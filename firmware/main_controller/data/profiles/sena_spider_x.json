{
    "id": "sena_spider_x",
    "name": "Sena Spider X Slim (Smart Cartridge 4-Actuator)",
    "vendor": "Sena Technologies",
    "hardware_tier": 1,
    "vcc_enabled": true,
    "direct_dc_supported": true,
    "direct_dc_voltage_v": 3.85,
    "soft_start_ms": 80,
    "input_gain_db": 1.5,
    "output_gain_db": 0.0,
    "noise_gate_threshold_db": -44,
    "control_mode": "smart_cartridge_mechatronic",
    "smart_cartridge": {
        "controller_type": "CH32V003_RISCV",
        "onewire_emulation": true,
        "protocol": "single_wire_uart_19200",
        "in_system_flashing": true,
        "config_version": 2,
        "num_actuators": 4,
        "actuator_mapping": {
            "ch1": "ACT_PLUS",
            "ch2": "ACT_MINUS",
            "ch3": "ACT_CENTER",
            "ch4": "ACT_MESH"
        },
        "command_table": {
            "0x01": { "name": "POWER_BOOT", "actuators": [1, 3], "duration_ms": 1000 },
            "0x02": { "name": "POWER_OFF", "actuators": [1, 3], "duration_ms": 200 },
            "0x03": { "name": "VOL_PLUS", "actuators": [1], "duration_ms": 100 },
            "0x04": { "name": "VOL_MINUS", "actuators": [2], "duration_ms": 100 },
            "0x05": { "name": "MESH_TOGGLE", "actuators": [4], "duration_ms": 200 },
            "0x06": { "name": "GROUP_MESH_TOGGLE", "actuators": [4], "duration_ms": 3000 },
            "0x07": {
                "name": "CHANNEL_NEXT_MACRO",
                "steps": [
                    { "actuator": 4, "pulses": 2, "pulse_ms": 150, "pause_ms": 150 },
                    { "delay_ms": 200 },
                    { "actuator": 1, "pulses": 1, "pulse_ms": 150, "pause_ms": 0 }
                ]
            },
            "0x08": {
                "name": "CHANNEL_PREV_MACRO",
                "steps": [
                    { "actuator": 4, "pulses": 2, "pulse_ms": 150, "pause_ms": 150 },
                    { "delay_ms": 200 },
                    { "actuator": 2, "pulses": 1, "pulse_ms": 150, "pause_ms": 0 }
                ]
            }
        }
    },
    "power_management": {
        "auto_wake_motion_sensor": true,
        "deep_sleep_timeout_min": 2,
        "motion_reactivation_window_days": 3,
        "auto_boot_solenoid_enabled": true,
        "auto_boot_timeout_sec": 2
    },
    "ptt_hold": false,
    "mesh_capabilities": {
        "protocol": "Sena_Mesh_3.0_Wave",
        "generation": 3,
        "max_nodes": 32,
        "open_mesh": true,
        "preconfig_channels": 6,
        "wave_intercom": true,
        "dle_bonus_score": 60
    },
    "rf_hardening": {
        "disable_bluetooth_classic": true,
        "clear_phone_gps_pairings": true,
        "enforce_mesh_only_mode": true,
        "disable_audio_multitasking": true,
        "expected_idle_current_ma": 35
    }
}
