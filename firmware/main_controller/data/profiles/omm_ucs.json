{
    "id": "omm_ucs",
    "name": "OpenMotorMesh UCS 2.4 GHz Intercom (PCBA 09)",
    "vendor": "OpenMotorBridge Open Source Hardware",
    "hardware_tier": 1,
    "vcc_enabled": true,
    "usb_charging_supported": true,
    "usb_charging_voltage_v": 5.0,
    "soft_start_ms": 100,
    "input_gain_db": 0.0,
    "output_gain_db": 0.0,
    "noise_gate_threshold_db": -50,
    "control_mode": "smart_cartridge_mechatronic",
    "smart_cartridge": {
        "controller_type": "CH32V003_RISCV",
        "onewire_emulation": true,
        "protocol": "single_wire_uart_19200",
        "in_system_flashing": true,
        "config_version": 2,
        "num_actuators": 4,
        "actuator_mapping": {
            "ch1": "ACT_PLUS",
            "ch2": "ACT_MINUS",
            "ch3": "ACT_CENTER",
            "ch4": "ACT_MESH"
        },
        "command_table": {
            "0x01": { "name": "POWER_BOOT", "actuators": [1, 3], "duration_ms": 1000 },
            "0x02": { "name": "POWER_OFF", "actuators": [1, 3], "duration_ms": 200 },
            "0x03": { "name": "VOL_PLUS", "actuators": [1], "duration_ms": 100 },
            "0x04": { "name": "VOL_MINUS", "actuators": [2], "duration_ms": 100 },
            "0x05": { "name": "MESH_TOGGLE", "actuators": [4], "duration_ms": 200 },
            "0x06": { "name": "GROUP_MESH_TOGGLE", "actuators": [4], "duration_ms": 3000 },
            "0x07": {
                "name": "CHANNEL_NEXT_MACRO",
                "steps": [
                    { "actuator": 4, "pulses": 2, "pulse_ms": 150, "pause_ms": 150 },
                    { "delay_ms": 200 },
                    { "actuator": 1, "pulses": 1, "pulse_ms": 150, "pause_ms": 0 }
                ]
            },
            "0x08": {
                "name": "CHANNEL_PREV_MACRO",
                "steps": [
                    { "actuator": 4, "pulses": 2, "pulse_ms": 150, "pause_ms": 150 },
                    { "delay_ms": 200 },
                    { "actuator": 2, "pulses": 1, "pulse_ms": 150, "pause_ms": 0 }
                ]
            }
        }
    },
    "ble_control": {
        "supported": true,
        "flavor": "omm_native",
        "service_uuid": "0x00MB",
        "device_name_prefix": "OMM-UCS",
        "characteristics": {
            "ptt_trigger": "0x0001",
            "mesh_mode": "0x0002",
            "channel": "0x0003",
            "volume": "0x0004",
            "telemetry": "0x0005",
            "le_audio_cfg": "0x0006"
        },
        "capabilities": {
            "power_boot": false,
            "power_off": true,
            "mesh_toggle": true,
            "group_toggle": true,
            "volume_control": true,
            "channel_select": true,
            "mic_mute": true,
            "telemetry": true,
            "le_audio_lc3": true,
            "bi_directional_stereo": true
        },
        "command_mapping": {
            "0x03": { "name": "VOL_PLUS", "ble_char": "0x0004", "ble_val": "step_up" },
            "0x04": { "name": "VOL_MINUS", "ble_char": "0x0004", "ble_val": "step_down" },
            "0x05": { "name": "MESH_TOGGLE", "ble_char": "0x0002", "ble_val": "toggle" },
            "0x06": { "name": "GROUP_MESH_TOGGLE", "ble_char": "0x0002", "ble_val": "private_group" },
            "0x07": { "name": "CHANNEL_NEXT", "ble_char": "0x0003", "ble_val": "next" },
            "0x08": { "name": "CHANNEL_PREV", "ble_char": "0x0003", "ble_val": "prev" }
        },
        "fallback_to_mechatronics_on_disconnect": true
    },
    "mesh_capabilities": {
        "protocol": "OpenMotorMesh_802_15_4_TDMA",
        "generation": 1,
        "max_nodes": 64,
        "open_mesh": true,
        "preconfig_channels": 16,
        "dle_bonus_score": 80
    },
    "rf_hardening": {
        "disable_bluetooth_classic": true,
        "clear_phone_gps_pairings": true,
        "enforce_mesh_only_mode": false,
        "disable_audio_multitasking": false,
        "expected_idle_current_ma": 28
    }
}
