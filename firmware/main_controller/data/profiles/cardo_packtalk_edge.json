{
    "id": "cardo_packtalk_edge",
    "name": "Cardo Packtalk Edge / Pro (Smart Cartridge 4-Actuator DMC Gen2)",
    "vendor": "Cardo Systems",
    "hardware_tier": 1,
    "vcc_enabled": true,
    "usb_charging_supported": true,
    "usb_charging_voltage_v": 5.0,
    "soft_start_ms": 100,
    "input_gain_db": 1.5,
    "output_gain_db": -0.5,
    "noise_gate_threshold_db": -48,
    "control_mode": "smart_cartridge_mechatronic",
    "smart_cartridge": {
        "controller_type": "CH32V003_RISCV",
        "onewire_emulation": true,
        "protocol": "single_wire_uart_19200",
        "in_system_flashing": true,
        "config_version": 2,
        "num_actuators": 4,
        "actuator_mapping": {
            "ch1": "ACT_MEDIA",
            "ch2": "ACT_MOBILE",
            "ch3": "ACT_INTERCOM",
            "ch4": "ACT_WHEEL_PRESS"
        },
        "command_table": {
            "0x01": {
                "name": "POWER_BOOT",
                "actuators": [1, 2],
                "duration_ms": 2000,
                "description": "Media + Mobile Button simultan 2s halten"
            },
            "0x02": {
                "name": "POWER_OFF",
                "actuators": [1, 2],
                "duration_ms": 2000,
                "description": "Media + Mobile Button simultan 2s halten"
            },
            "0x03": {
                "name": "DMC_MUTE_TOGGLE",
                "actuators": [4],
                "duration_ms": 2000,
                "description": "Control Wheel Center-Press 2s halten: DMC Gruppe stummschalten/aktivieren"
            },
            "0x04": {
                "name": "WHEEL_CENTER_TAP",
                "actuators": [4],
                "duration_ms": 150,
                "description": "Control Wheel Center-Press kurzer Klick: Audio Stop / Anruf halten"
            },
            "0x05": {
                "name": "DMC_INTERCOM_TOGGLE",
                "actuators": [3],
                "duration_ms": 200,
                "description": "Intercom Button kurzer Tastendruck: DMC Intercom Audio ein/aus"
            },
            "0x06": {
                "name": "DMC_GROUPING",
                "actuators": [3],
                "duration_ms": 5000,
                "description": "Intercom Button 5s halten: DMC Grouping / Kopplungsmodus (LED rot/grün)"
            },
            "0x07": {
                "name": "DMC_PRIVATE_CHAT_MACRO",
                "steps": [
                    { "actuator": 3, "pulses": 2, "pulse_ms": 150, "pause_ms": 150 }
                ],
                "description": "Intercom Button Doppelklick: Wechsel zwischen voller DMC-Gruppe und Private Chat"
            },
            "0x08": {
                "name": "DMC_BRIDGE_MACRO",
                "steps": [
                    { "actuator": 3, "pulses": 3, "pulse_ms": 150, "pause_ms": 150 }
                ],
                "description": "Intercom Button Dreifachklick: Bluetooth-Headset in DMC-Mesh-Gruppe bridgen"
            },
            "0x09": {
                "name": "PHONE_PAIRING",
                "actuators": [2],
                "duration_ms": 5000,
                "description": "Mobile Button 5s halten: Phone/GPS Bluetooth-Kopplungsmodus (LED rot/blau)"
            }
        }
    },
    "power_management": {
        "auto_wake_motion_sensor": true,
        "deep_sleep_timeout_min": 2,
        "motion_reactivation_window_days": 3,
        "auto_boot_solenoid_enabled": true,
        "auto_boot_timeout_sec": 2
    },
    "ptt_hold": false,
    "mesh_capabilities": {
        "protocol": "Cardo_DMC_2.0",
        "generation": 2,
        "max_nodes": 32,
        "open_mesh": true,
        "preconfig_channels": 15,
        "dle_bonus_score": 60
    },
    "rf_hardening": {
        "disable_bluetooth_classic": true,
        "clear_phone_gps_pairings": true,
        "enforce_mesh_only_mode": true,
        "disable_audio_multitasking": true,
        "expected_idle_current_ma": 40
    }
}
