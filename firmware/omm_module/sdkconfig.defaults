# Target Configuration
CONFIG_IDF_TARGET="esp32c6"
CONFIG_IDF_TARGET_ESP32C6=y

# CPU & Memory Options
CONFIG_ESP32C6_DEFAULT_CPU_FREQ_160=y
CONFIG_ESP32C6_DEFAULT_CPU_FREQ_MHZ=160
CONFIG_FREERTOS_HZ=1000

# Flash Configuration
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"

# OTA Rollback Protection
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# Native USB JTAG / Serial CDC Console
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# 802.15.4 / ESP-NOW Low Latency Audio Tuning
CONFIG_ESP_WIFI_ESPNOW_MAX_ENCRYPT_NUM=7
CONFIG_ESP32_WIFI_AMPDU_TX_ENABLED=y
CONFIG_ESP32_WIFI_AMPDU_RX_ENABLED=y

# Power Management / Dynamic Frequency Scaling
CONFIG_PM_ENABLE=y
CONFIG_PM_DFS_INIT_AUTO=y

# Dedicated Pure Mesh RF Engine: Disable Bluetooth on C6 to eliminate CoEx time-slicing
CONFIG_BT_ENABLED=n

