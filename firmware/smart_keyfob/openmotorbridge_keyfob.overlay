// OpenMotorBridge - PCBA 07 Smart Keyfob & Silent Pager DeviceTree Overlay
// Target: Nordic Semiconductor nRF52832-QFxx (QFN-48)

/ {
    chosen {
        zephyr,console = &rtt0;
        zephyr,shell-uart = &rtt0;
    };

    aliases {
        led0 = &status_led;
        sw0 = &button_arm;
        sw1 = &button_sos;
    };

    buttons {
        compatible = "gpio-keys";
        button_arm: button_0 {
            gpios = <&gpio0 20 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "Arm/Disarm Switch SW1";
        };
        button_sos: button_1 {
            gpios = <&gpio0 22 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "Panic/SOS Switch SW2";
        };
        chg_stat: chg_stat_0 {
            gpios = <&gpio0 19 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
            label = "BQ25100 Charge Status";
        };
    };

    leds {
        compatible = "gpio-leds";
        drv_en: drv_en_0 {
            gpios = <&gpio0 28 GPIO_ACTIVE_HIGH>;
            label = "DRV2605L Haptics Enable";
        };
    };
};

&rtt0 {
    status = "okay";
};

// I2C0 for TI DRV2605L Haptic Driver (SDA=P0.29, SCL=P0.30)
&i2c0 {
    status = "okay";
    compatible = "nordic,nrf-twim";
    pinctrl-0 = <&i2c0_default>;
    pinctrl-1 = <&i2c0_sleep>;
    pinctrl-names = "default", "sleep";
    clock-frequency = <I2C_BITRATE_FAST>;

    drv2605l: drv2605l@5a {
        compatible = "ti,drv2605";
        reg = <0x5a>;
        label = "DRV2605L";
    };
};

// SPI1 for Semtech SX1262 LoRa Transceiver (SCK=P0.02, MOSI=P0.03, MISO=P0.04, CS=P0.05)
&spi1 {
    status = "okay";
    compatible = "nordic,nrf-spim";
    pinctrl-0 = <&spi1_default>;
    pinctrl-1 = <&spi1_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio0 5 GPIO_ACTIVE_LOW>;

    lora_sx1262: sx1262@0 {
        compatible = "semtech,sx1262";
        reg = <0>;
        spi-max-frequency = <10000000>;
        reset-gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;
        busy-gpios  = <&gpio0 7 GPIO_ACTIVE_HIGH>;
        dio1-gpios  = <&gpio0 6 GPIO_ACTIVE_HIGH>;
        label = "SX1262";
    };
};

// PWM0 for Piezo Buzzer (P0.24)
&pwm0 {
    status = "okay";
    pinctrl-0 = <&pwm0_default>;
    pinctrl-1 = <&pwm0_sleep>;
    pinctrl-names = "default", "sleep";
};
