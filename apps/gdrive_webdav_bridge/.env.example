# ==============================================================================
# OpenMotorBridge Google Drive WebDAV Bridge - Configuration
# ==============================================================================

# Server settings
HOST=0.0.0.0
PORT=8080
LOG_LEVEL=INFO

# WebDAV Authentication (used by OpenMotorBridge Central Box & PWA)
WEBDAV_USER=omb
WEBDAV_PASSWORD=MeinGeheimesMotorradPasswort123

# Google Drive OAuth2 Credentials
# (Obtain CLIENT_ID & SECRET from Google Cloud Console -> APIs & Services -> Credentials)
# (Run 'python auth_helper.py' to generate your GOOGLE_REFRESH_TOKEN)
GOOGLE_CLIENT_ID=113806676655-xxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_REFRESH_TOKEN=1//0gxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GOOGLE_DRIVE_FOLDER=omb/tracks

# ==============================================================================
# Optional: Event Notifications (Home Assistant / Homesphere / Webhook)
# ==============================================================================

# MQTT Event Push (Set MQTT_ENABLED=true or provide MQTT_BROKER)
MQTT_ENABLED=false
MQTT_BROKER=192.168.1.50
MQTT_PORT=1883
MQTT_TOPIC=homesphere/omb/track_uploaded
MQTT_USERNAME=
MQTT_PASSWORD=

# Optional Webhook (Dispatches HTTP POST with ride stats on every upload)
WEBHOOK_URL=
