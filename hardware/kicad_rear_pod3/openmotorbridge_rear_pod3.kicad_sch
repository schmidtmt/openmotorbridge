(kicad_sch (version 20230121) (generator eeschema)

  (uuid "f0000000-0000-0000-0000-000000000001")

  (paper "A3")

  (title_block
    (title "OpenMotorBridge v8.0 - Heck-Pod 3 (GNSS & OpenMotorMesh LoRa)")
    (date "2026-08-23")
    (rev "v8.0")
    (company "OpenMotorBridge Open Source Hardware")
    (comment 1 "u-blox MAX-M10S 10Hz GNSS + Semtech SX1262 LoRa (+22 dBm @ 868 MHz)")
    (comment 2 "ESP32-C3 RISC-V Co-Prozessor + DS2401 1-Wire ID + 6-Pin Pogo Interface")
  )

  (text "BLOCK 1: 6-POLIGES MILL-MAX POGO-INTERFACE (ZUR ZENTRALBOX):\n- Pin 1: POD3_VCC (5.0V Dauer-Versorgung)\n- Pin 2: POD3_GND (Power- & Signalmasse)\n- Pin 3: POD3_UART_TX (Heck ESP32-C3 -> Zentralbox @ 460.800 Baud)\n- Pin 4: POD3_UART_RX (Zentralbox -> Heck ESP32-C3)\n- Pin 5: POD3_GNSS_PPS (1-PPS Hardware-Zeitnormal Sync an ESP32-S3)\n- Pin 6: POD3_1WIRE_ID (DS2401 Silicon Serial Number zur Kassetten-Erkennung)" (at 25.4 45.0 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
  )

  (text "BLOCK 2: ESP32-C3 CO-PROZESSOR (32-BIT RISC-V @ 160 MHz):\n- Entlastet die Haupt-MCU vollstaendig von NMEA/UBX-Parsing & LoRa Frame En-/Decodierung\n- UART0: High-Speed Bridge zur Zentralbox (GPIO 20 / GPIO 21 @ 460.800 Baud)\n- UART1: Interface zum MAX-M10S (GPIO 0 / GPIO 1 @ 38.400 Baud)\n- SPI Master: Interface zum SX1262 LoRa (SCK GPIO 4, MISO GPIO 5, MOSI GPIO 6, NSS GPIO 7)\n- GPIO 8: SX1262 BUSY, GPIO 9: SX1262 DIO1 (Packet Rx Interrupt), GPIO 10: SX1262 NRST\n- GPIO 3: GNSS 1-PPS Input Interrupt (MAX-M10S TIMEPULSE)" (at 25.4 90.0 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
  )

  (text "BLOCK 3: GNSS ENGINE (U-BLOX MAX-M10S):\n- Multi-Konstellation 4-System Parallelbetrieb (GPS, GLONASS, Galileo, BeiDou)\n- 25 x 25 x 4 mm Keramik-Patchantenne mit integriertem LNA & SAW-Filter\n- 10 Hz PVT Navigation Rate\n- Zeitstempelgenauigkeit < 15 ns RMS" (at 25.4 140.0 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
  )

  (text "BLOCK 4: OPENMOTORMESH LORA TRANSCEIVER (SEMTECH SX1262):\n- Frequenz: 868.0 - 868.6 MHz (EU ISM Band, Bandbreite 250 kHz, SF7..SF11)\n- Ausgangsleistung: +22 dBm PA\n- Antenne: 868 MHz Wendel-/Dipol-Antenne im Heckbuerzel integriert\n- Dynamic Leader Election (DLE) Routing Engine" (at 25.4 175.0 0)
    (effects (font (size 1.27 1.27)) (justify left bottom))
  )
)
