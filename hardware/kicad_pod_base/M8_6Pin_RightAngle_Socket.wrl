#VRML V2.0 utf8
# M8 6-Pin A-Coded Industrial Sensor Receptacle (Right-Angle PCB Mount)
# OpenMotorBridge - IEC 61076-2-104 compliant 3D Model

Group {
  children [
    # 1. Main Plastic Body Block (Seated at back on PCB)
    Transform {
      translation 0.0 2.0 4.0
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.15 0.15 0.17
              specularColor 0.3 0.3 0.3
              shininess 0.3
            }
          }
          geometry Box {
            size 8.5 6.0 7.5
          }
        }
      ]
    }

    # 2. Outer Threaded Metal Barrel (M8x0.5 Nickel-Plated Brass) extending horizontally towards bottom edge (-Y)
    Transform {
      translation 0.0 -4.0 4.0
      rotation 1.0 0.0 0.0 1.5708
      children [
        Shape {
          appearance Appearance {
            material Material {
              diffuseColor 0.82 0.84 0.86
              specularColor 0.98 0.98 0.98
              shininess 0.92
              ambientIntensity 0.35
            }
          }
          geometry Cylinder {
            radius 4.2
            height 8.0
          }
        }
      ]
    }

    # 3. Thread / Knurled Flange Ring
    Transform {
      translation 0.0 -2.0 4.0
