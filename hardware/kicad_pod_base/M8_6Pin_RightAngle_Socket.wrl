            }
          }
          geometry Cylinder {
            radius 4.6
            height 2.0
          }
        }
      ]
    }

    # 4. Black Insulator Core (Front face of M8 socket at Y = -7.5)
    Transform {
      translation 0.0 -7.5 4.0
